{
  "name": "daozi",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "husky install",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "pnpm test:score && pnpm test:game && pnpm test:gameplay",
    "test:score": "node --import ./scripts/ts-resolve.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-score.ts",
    "test:game": "node --import ./scripts/ts-resolve.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-game.ts",
    "test:gameplay": "node --import ./scripts/ts-resolve.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-gameplay.ts",
    "stylint": "stylelint \"src/**/*.{css,less,scss,sass,styl}\" --fix"
  },
  "dependencies": {
    "lodash.shuffle": "^4.2.0",
    "vue": "^3.2.37",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/lodash.shuffle": "^4.2.7",
    "@types/node": "^18.7.13",
    "@vitejs/plugin-legacy": "^2.0.1",
    "@vitejs/plugin-vue-jsx": "^2.0.0",
    "husky": "^8.0.1",
    "terser": "^5.15.0",
    "typescript": "^4.8.2",
    "vite": "^3.0.9",
    "vite-plugin-pages": "^0.25.0",
    "vite-plugin-pwa": "^0.12.6",
    "vite-plugin-windicss": "^1.8.7",
    "vue-tsc": "^0.40.4",
    "windicss": "^3.5.6"
  },
  "engines": {
    "node": ">=10.0.0"
  }
}
